{
  "name": "dsh-llm-approve-for-me",
  "version": "0.4.0",
  "description": "LLM-only one-shot sandbox approval reviewer for DeepSeek Harness.",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./cordis.patch.yml": "./dsh/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["dsh/", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test dsh/*.test.js",
    "check": "node --check dsh/index.js && npm test"
  },
  "dsh": {
    "bundle": { "patch": "./dsh/cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "keywords": ["dsh", "deepseek-harness", "approval", "llm-review", "sandbox"],
  "author": "lizhiyuan",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.1",
    "@deepseek-ai/dsh-permission-presets": "0.1.1-rc.1",
    "@deepseek-ai/dsh-host-web-server": "0.1.1-rc.1"
  }
}
